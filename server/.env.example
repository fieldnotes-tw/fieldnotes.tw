PORT=3001
DATABASE_URL=postgres://lately:lately@127.0.0.1:5432/lately
JWT_SECRET=replace-with-a-long-random-string
COOKIE_SECURE=0
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
ADMIN_EMAIL=admin@fieldnotes.tw
ADMIN_PASSWORD=replace-me
MAIL_MODE=log
APP_BASE_URL=http://127.0.0.1:3001
EMAIL_FROM=noreply@localhost
# LINE Login (https://developers.line.biz/). Callback defaults to ${APP_BASE_URL}/api/auth/line/callback
# Local dev: register both http://localhost:3001/api/auth/line/callback and http://127.0.0.1:3001/api/auth/line/callback
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
# LINE_CALLBACK_URL=
# Leave MEDIA_BUCKET empty for local disk uploads under server/public/media/.
# Staging/prod set this to the media bucket name (S3 presigned uploads).
MEDIA_BUCKET=
MEDIA_PUBLIC_PREFIX=/media
# Set to 1 to load demo phenomena (images from public/images via npm run seed:media-local).
SEED_DEMO=1
# Optional: link demo "Chao" sightings to your member account (your login email).
# DEMO_MEMBER_EMAIL=you@example.com
