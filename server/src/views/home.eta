<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <filter id="rough" x="-20%" y="-20%" width="140%" height="140%">
    <feTurbulence type="fractalNoise" baseFrequency="0.045 0.09" numOctaves="2" seed="7" result="n"/>
    <feDisplacementMap in="SourceGraphic" in2="n" scale="3.2"/>
  </filter>
</svg>

<div class="floatingbar" id="floatingbar">
  <div class="floatingbar__row">
    <a href="#top" class="brand-mark" aria-label="<%= it.t('brand.name') %>"><span>最</span><span>近</span><span>左</span><span>營</span></a>
    <div class="floatingbar__menu">
      <label class="cat-toggle check-item" data-cat="animal"><span class="check-item__box"></span><span><%= it.t('category.animal') %></span></label>
      <label class="cat-toggle check-item" data-cat="plant"><span class="check-item__box"></span><span><%= it.t('category.plant') %></span></label>
      <label class="cat-toggle check-item" data-cat="sky"><span class="check-item__box"></span><span><%= it.t('category.sky') %></span></label>
      <label class="cat-toggle check-item" data-cat="taste"><span class="check-item__box"></span><span><%= it.t('category.taste') %></span></label>
      <label class="cat-toggle check-item" data-cat="workshop"><span class="check-item__box"></span><span><%= it.t('category.workshop') %></span></label>
    </div>
    <div class="auth-nav" data-auth-nav></div>
  </div>
</div>

<header class="sitehead" id="top">
  <div class="sitehead__weather serif-ui">
    <span class="sitehead__weather-text"><span id="todayDate"><%= it.t('home.today') %></span> <span id="weatherText"><%= it.t('home.weatherLoading') %></span></span>
    <div class="auth-nav" data-auth-nav></div>
  </div>
  <div class="sitehead__brandrow">
    <div class="sitehead__identity">
      <h1 class="brand-mark"><span>最</span><span>近</span><span>左</span><span>營</span></h1>
      <div class="sitehead__taglines">
        <span><%= it.t('home.tagline1') %></span>
        <span><%= it.t('home.tagline2') %></span>
      </div>
    </div>
    <nav class="sitehead__menu" aria-label="<%= it.t('nav.categories') %>">
      <span class="cat-toggle sitehead__menu-oval" data-cat="plant" role="button" tabindex="0" aria-pressed="false" aria-label="<%= it.t('category.plant') %>"><%~ it.chars('category.plant.oval') %></span>
      <span class="cat-toggle sitehead__menu-oval" data-cat="animal" role="button" tabindex="0" aria-pressed="false" aria-label="<%= it.t('category.animal') %>"><%~ it.chars('category.animal.oval') %></span>
      <span class="cat-toggle sitehead__menu-oval" data-cat="sky" role="button" tabindex="0" aria-pressed="false" aria-label="<%= it.t('category.sky') %>"><%~ it.chars('category.sky.oval') %></span>
      <span class="cat-toggle sitehead__menu-oval" data-cat="taste" role="button" tabindex="0" aria-pressed="false" aria-label="<%= it.t('category.taste') %>"><%~ it.chars('category.taste.oval') %></span>
      <span class="cat-toggle sitehead__menu-oval" data-cat="workshop" role="button" tabindex="0" aria-pressed="false" aria-label="<%= it.t('category.workshop') %>"><%~ it.chars('category.workshop.oval') %></span>
    </nav>
  </div>
</header>

<section class="section" id="phenomena">
  <div class="view-toggle" role="group" aria-label="<%= it.t('home.viewToggle') %>">
    <button type="button" class="view-toggle__btn is-active" data-view="list">
      <svg class="view-toggle__icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="8" height="8" rx="1.5"/><rect x="13" y="3" width="8" height="8" rx="1.5"/><rect x="3" y="13" width="8" height="8" rx="1.5"/><rect x="13" y="13" width="8" height="8" rx="1.5"/></svg>
      <span><%= it.t('home.view.cards') %></span>
    </button>
    <button type="button" class="view-toggle__btn" data-view="map">
      <svg class="view-toggle__icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"><path d="M9 4 3 6v14l6-2 6 2 6-2V4l-6 2-6-2Z"/><path d="M9 4v14M15 6v14"/></svg>
      <span><%= it.t('home.view.map') %></span>
    </button>
  </div>

  <div class="grid-feed" id="gridFeed" aria-live="polite"></div>

  <div class="map-view is-hidden" id="mapView">
    <div class="map-frame" id="mapFrame">
      <div class="map-sheet" id="mapSheet">
        <button type="button" class="map-sheet__close" id="mapSheetClose" aria-label="<%= it.t('home.close') %>">
          <svg viewBox="0 0 24 24" width="16" height="16"><path d="M5 5 L19 19 M19 5 L5 19" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>
        </button>
        <button type="button" class="map-sheet__collapse" id="mapSheetCollapse" aria-label="<%= it.t('home.collapsePanel') %>">
          <svg viewBox="0 0 24 24" width="14" height="14"><path d="M15 5 L8 12 L15 19" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" fill="none"/></svg>
        </button>
        <div class="map-sheet__body" id="mapSheetBody"></div>
      </div>
      <div class="map-view__canvas" id="mapCanvas"></div>
    </div>
  </div>
</section>

<div class="card-modal" id="cardModal">
  <div class="card-modal__backdrop" id="cardModalBackdrop"></div>
  <div class="card-modal__panel" id="cardModalPanel">
    <button type="button" class="card-modal__close" id="cardModalClose" aria-label="<%= it.t('home.close') %>">
      <svg viewBox="0 0 24 24" width="16" height="16"><path d="M5 5 L19 19 M19 5 L5 19" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>
    </button>
    <div class="card-modal__body" id="cardModalBody"></div>
  </div>
</div>

<%~ include('partials/contributors', it) %>

<footer id="about">
  <div class="about__block">
    <div class="about__head"><%= it.t('home.about.title') %></div>
    <div class="about__row">
      <div class="about__bird-wrap">
        <p class="about__bird-bubble"><%= it.t('home.about.birdBubble') %></p>
        <svg class="about__bird rough" viewBox="0 0 120 120" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="50" cy="50" r="16"/>
          <path d="M64 46 L82 38 L68 56 Z"/>
          <circle cx="44" cy="46" r="2" fill="currentColor" stroke="none"/>
          <path d="M40 64 L34 84 M56 66 L58 86"/>
        </svg>
      </div>
      <div>
        <p class="about__text"><strong><%= it.t('home.about.bodyTitle') %></strong><%= it.t('home.about.body') %></p>
        <p class="about__cta"><%= it.t('home.about.ctaBefore') %><a href="https://forms.gle/Ln8WBNaK5s8fggTYA" class="about__cta-link" target="_blank" rel="noopener"><%= it.t('home.about.ctaLink') %></a><%= it.t('home.about.ctaAfter') %></p>
      </div>
    </div>
  </div>
  <div class="footer__row">
    <span class="credit"><%= it.t('home.footer.credit') %></span>
    <span class="credit"><%= it.t('home.footer.prototype') %></span>
  </div>
</footer>
