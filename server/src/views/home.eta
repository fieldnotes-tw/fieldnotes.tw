<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <filter id="rough" x="-20%" y="-20%" width="140%" height="140%">
    <feTurbulence type="fractalNoise" baseFrequency="0.045 0.09" numOctaves="2" seed="7" result="n"/>
    <feDisplacementMap in="SourceGraphic" in2="n" scale="3.2"/>
  </filter>
</svg>

<div class="floatingbar" id="floatingbar">
  <div class="floatingbar__row">
    <a href="#top" class="brand-mark" aria-label="<%= it.t('brand.name') %>"><span>最</span><span>近</span><span>高</span><span>雄</span></a>
    <div class="floatingbar__actions">
      <button type="button" class="floatingbar__lang-btn" id="floatingLangBtn" aria-label="<%= it.t('nav.lang.label') %>" aria-expanded="false" aria-controls="floatingLangPanel">
        <svg class="floatingbar__lang-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="9"/>
          <path d="M3 12h18"/>
          <path d="M12 3a15.3 15.3 0 0 1 4 9 15.3 15.3 0 0 1-4 9 15.3 15.3 0 0 1-4-9 15.3 15.3 0 0 1 4-9z"/>
        </svg>
      </button>
      <div class="auth-nav" data-auth-nav></div>
    </div>
  </div>
  <div class="floatingbar__lang-panel" id="floatingLangPanel" hidden>
    <div class="floatingbar__lang-menu" role="group" aria-label="<%= it.t('nav.lang.label') %>">
      <button type="button" class="floatingbar__lang-option" data-locale="zh-Hant"><%= it.t('nav.lang.zh') %></button>
      <button type="button" class="floatingbar__lang-option" data-locale="en"><%= it.t('nav.lang.en') %></button>
    </div>
  </div>
</div>

<header class="sitehead" id="top">
  <div class="sitehead__weather serif-ui">
    <div class="sitehead__weather-info">
      <time class="sitehead__date" id="todayDate"><%= it.t('home.today') %></time>
      <span class="sitehead__conditions" id="weatherText"><%= it.t('home.weatherLoading') %></span>
    </div>
    <div class="auth-nav" data-auth-nav></div>
  </div>
  <div class="sitehead__brandrow">
    <div class="sitehead__identity">
      <h1 class="brand-mark"><span>最</span><span>近</span><span>高</span><span>雄</span></h1>
      <div class="sitehead__taglines">
        <span><%= it.t('home.tagline1') %></span>
        <span><%= it.t('home.tagline2') %></span>
      </div>
    </div>
    <nav class="sitehead__menu" aria-label="<%= it.t('nav.categories') %>">
      <span class="cat-toggle sitehead__menu-oval" data-cat="plant" role="button" tabindex="0" aria-pressed="false" aria-label="<%= it.t('category.plant') %>"><%~ it.chars('category.plant.oval') %></span>
      <span class="cat-toggle sitehead__menu-oval" data-cat="animal" role="button" tabindex="0" aria-pressed="false" aria-label="<%= it.t('category.animal') %>"><%~ it.chars('category.animal.oval') %></span>
      <span class="cat-toggle sitehead__menu-oval" data-cat="sky" role="button" tabindex="0" aria-pressed="false" aria-label="<%= it.t('category.sky') %>"><%~ it.chars('category.sky.oval') %></span>
      <span class="cat-toggle sitehead__menu-oval" data-cat="taste" role="button" tabindex="0" aria-pressed="false" aria-label="<%= it.t('category.taste') %>"><%~ it.chars('category.taste.oval') %></span>
      <span class="cat-toggle sitehead__menu-oval" data-cat="workshop" role="button" tabindex="0" aria-pressed="false" aria-label="<%= it.t('category.workshop') %>"><%~ it.chars('category.workshop.oval') %></span>
    </nav>
  </div>
</header>

<section class="section" id="phenomena">
  <div class="feed-shell" id="feedShell">
    <div class="feed-stage" id="feedStage">
      <aside class="feed-layout__detail" id="feedDetailPane" aria-hidden="true">
        <header class="feed-detail__header" id="feedDetailHeader">
          <div class="feed-detail__header-row">
            <button type="button" class="feed-detail__menu-btn" id="feedDetailMenuBtn" aria-label="<%= it.t('home.detail.itemMenu') %>" aria-expanded="false" aria-controls="feedDetailMenuPanel">
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M6 9 L12 15 L18 9" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" fill="none"/></svg>
            </button>
            <p class="feed-detail__header-title" id="feedDetailHeaderTitle"></p>
            <button type="button" class="feed-detail__header-close" id="feedDetailHeaderClose" aria-label="<%= it.t('home.detail.backToList') %>">
              <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M5 5 L19 19 M19 5 L5 19" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>
            </button>
          </div>
          <div class="feed-detail__menu-panel" id="feedDetailMenuPanel" hidden>
            <div class="feed-detail__menu-list" id="feedDetailMenuList" role="listbox" aria-label="<%= it.t('home.detail.itemMenu') %>"></div>
          </div>
        </header>
        <button type="button" class="feed-detail__rail-btn" id="feedDetailRailBtn" aria-label="<%= it.t('home.detail.backToRail') %>" hidden>
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <path d="M8 6h12M8 12h12M8 18h12"/>
            <circle cx="4" cy="6" r="1" fill="currentColor" stroke="none"/>
            <circle cx="4" cy="12" r="1" fill="currentColor" stroke="none"/>
            <circle cx="4" cy="18" r="1" fill="currentColor" stroke="none"/>
          </svg>
        </button>
        <div class="feed-detail__body" id="feedDetailBody"></div>
      </aside>
      <aside class="map-rail" id="mapRail" hidden aria-hidden="true">
        <div class="map-rail__list" id="mapRailList"></div>
      </aside>
      <div class="feed-stage__main">
        <div class="feed-controls" id="feedControls">
          <div class="feed-toolbar">
            <div class="feed-toolbar__cluster">
              <div class="feed-toolbar__cluster-row">
                <button type="button" class="feed-toolbar__search-btn" id="feedSearchBtn" aria-label="<%= it.t('home.search') %>" aria-expanded="false" aria-controls="feedSearchPanel">
                  <svg class="feed-toolbar__search-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                    <circle cx="11" cy="11" r="7"/>
                    <path d="M20 20 L16.5 16.5"/>
                  </svg>
                </button>
                <div class="view-toggle" role="group" aria-label="<%= it.t('home.viewToggle') %>">
                  <button type="button" class="view-toggle__btn is-active" data-view="list">
                    <svg class="view-toggle__icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="8" height="8" rx="1.5"/><rect x="13" y="3" width="8" height="8" rx="1.5"/><rect x="3" y="13" width="8" height="8" rx="1.5"/><rect x="13" y="13" width="8" height="8" rx="1.5"/></svg>
                    <span><%= it.t('home.view.cards') %></span>
                  </button>
                  <button type="button" class="view-toggle__btn" data-view="map">
                    <svg class="view-toggle__icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" aria-hidden="true"><path d="M9 4 3 6v14l6-2 6 2 6-2V4l-6 2-6-2Z"/><path d="M9 4v14M15 6v14"/></svg>
                    <span><%= it.t('home.view.map') %></span>
                  </button>
                </div>
              </div>
              <div class="feed-toolbar__search-panel" id="feedSearchPanel" hidden>
                <label class="feed-toolbar__search-field">
                  <span class="visually-hidden"><%= it.t('home.search') %></span>
                  <input type="search" class="feed-toolbar__search-input" id="feedSearchInput" placeholder="<%= it.t('home.searchPlaceholder') %>" autocomplete="off" enterkeyhint="search">
                </label>
              </div>
            </div>
            <button type="button" class="feed-toolbar__filter-btn" id="feedFilterBtn" aria-label="<%= it.t('home.advancedSearch') %>" aria-expanded="false" aria-controls="feedFilterPanel">
              <svg class="feed-toolbar__filter-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                <path d="M10 5 H22 M2 5 H6 M14 12 H22 M2 12 H10 M18 19 H22 M2 19 H14"/>
                <circle cx="8" cy="5" r="2"/>
                <circle cx="12" cy="12" r="2"/>
                <circle cx="16" cy="19" r="2"/>
              </svg>
            </button>
            <div class="feed-toolbar__filter-panel" id="feedFilterPanel" hidden>
              <div class="feed-toolbar__filter-menu" role="group" aria-label="<%= it.t('nav.categories') %>">
                <label class="cat-toggle check-item" data-cat="plant"><span class="check-item__box"></span><span><%= it.t('category.plant') %></span></label>
                <label class="cat-toggle check-item" data-cat="animal"><span class="check-item__box"></span><span><%= it.t('category.animal') %></span></label>
                <label class="cat-toggle check-item" data-cat="sky"><span class="check-item__box"></span><span><%= it.t('category.sky') %></span></label>
                <label class="cat-toggle check-item" data-cat="taste"><span class="check-item__box"></span><span><%= it.t('category.taste') %></span></label>
                <label class="cat-toggle check-item" data-cat="workshop"><span class="check-item__box"></span><span><%= it.t('category.workshop') %></span></label>
              </div>
            </div>
          </div>
        </div>
        <div class="feed-layout-host" id="feedLayoutHost">
          <div class="feed-layout" id="feedLayout">
            <div class="feed-layout__list">
              <div class="grid-feed" id="gridFeed" aria-live="polite"></div>
            </div>
          </div>
        </div>

        <div class="map-view is-hidden" id="mapView">
          <div class="map-frame" id="mapFrame">
            <div class="map-view__canvas" id="mapCanvas"></div>
          </div>
        </div>
      </div>
      <div class="map-sheet" id="mapSheet">
        <header class="map-sheet__header" id="mapSheetHeader" hidden>
          <button type="button" class="map-sheet__back" id="mapSheetBack" aria-label="<%= it.t('home.detail.backToList') %>">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M14 6 L8 12 L14 18" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" fill="none"/></svg>
            <span id="mapSheetBackLabel"><%= it.t('home.detail.back') %></span>
          </button>
        </header>
        <button type="button" class="map-sheet__handle" id="mapSheetHandle" aria-label="<%= it.t('home.expandPanel') %>">
          <span class="map-sheet__handle-bar" aria-hidden="true"></span>
        </button>
        <button type="button" class="map-sheet__close" id="mapSheetClose" aria-label="<%= it.t('home.close') %>">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M5 5 L19 19 M19 5 L5 19" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>
        </button>
        <div class="map-sheet__body" id="mapSheetBody"></div>
        <div class="map-sheet__peek-footer" id="mapSheetPeekNav" hidden aria-hidden="true">
          <button type="button" class="map-sheet__peek-nav-btn" id="mapSheetPeekPrev" aria-label="<%= it.t('home.mapPrevPin') %>">
            <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M14 6 L8 12 L14 18" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" fill="none"/></svg>
          </button>
          <div class="map-sheet__peek-meta">
            <div class="map-sheet__peek-dots" id="mapSheetPinDots" aria-hidden="true"></div>
            <span class="map-sheet__peek-counter" id="mapSheetPinCounter" aria-live="polite"></span>
          </div>
          <button type="button" class="map-sheet__peek-nav-btn" id="mapSheetPeekNext" aria-label="<%= it.t('home.mapNextPin') %>">
            <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M10 6 L16 12 L10 18" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" fill="none"/></svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<%~ include('partials/contributors', it) %>

<div class="card-modal" id="cardModal">
  <div class="card-modal__backdrop" id="cardModalBackdrop"></div>
  <div class="card-modal__panel" id="cardModalPanel">
    <button type="button" class="card-modal__close" id="cardModalClose" aria-label="<%= it.t('home.close') %>">
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M5 5 L19 19 M19 5 L5 19" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>
    </button>
    <div class="card-modal__body" id="cardModalBody"></div>
  </div>
</div>


<footer id="about">
  <div class="about__block">
    <div class="about__head"><%= it.t('home.about.title') %></div>
    <div class="about__row">
      <div class="about__bird-wrap">
        <p class="about__bird-bubble" id="aboutBirdBubble" aria-live="polite"><%= it.t('home.about.birdBubble.0') %></p>
        <button type="button" class="about__bird-btn" id="aboutBirdBtn" aria-label="<%= it.t('home.about.birdBubble.next') %>">
          <svg class="about__bird rough" viewBox="0 0 120 120" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="50" cy="50" r="16"/>
            <path d="M64 46 L82 38 L68 56 Z"/>
            <circle cx="44" cy="46" r="2" fill="currentColor" stroke="none"/>
            <path d="M40 64 L34 84 M56 66 L58 86"/>
          </svg>
        </button>
      </div>
      <div>
        <p class="about__text"><strong><%= it.t('home.about.bodyTitle') %></strong><%= it.t('home.about.body') %></p>
        <p class="about__text"><%= it.t('home.about.body2') %></p>
        <p class="about__text"><span class="about__mark"><%= it.t('home.about.welcome') %></span><%= it.t('home.about.body3') %></p>
        <div class="about__actions">
          <a href="/register" class="about__btn about__btn--primary"><%= it.t('nav.register') %></a>
        </div>
      </div>
    </div>
  </div>
  <div class="footer__row">
    <span class="credit"><%= it.t('home.footer.credit') %></span>
  </div>
</footer>
