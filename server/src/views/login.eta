<header class="auth-page-head">
  <a href="/" class="brand-mark" aria-label="<%= it.t('brand.name') %>"><span>最</span><span>近</span><span>高</span><span>雄</span></a>
  <div class="auth-nav" data-auth-nav></div>
</header>

<main class="auth-main">
  <div class="auth-form">
    <h1 class="auth-form__title"><%= it.t('auth.login.title') %></h1>
    <form id="loginForm" novalidate>
      <label class="auth-form__field">
        <span><%= it.t('auth.field.email') %></span>
        <input type="email" name="email" autocomplete="email" required>
      </label>
      <label class="auth-form__field">
        <span><%= it.t('auth.field.password') %></span>
        <input type="password" name="password" autocomplete="current-password" required minlength="8">
      </label>
      <p class="auth-form__error" id="loginError" hidden></p>
      <p class="auth-form__switch auth-form__switch--compact"><a href="/forgot-password"><%= it.t('auth.login.forgotLink') %></a></p>
      <button type="submit" class="auth-form__submit"><%= it.t('auth.login.submit') %></button>
    </form>
    <div class="auth-form__divider"><span><%= it.t('auth.register.or') %></span></div>
    <button type="button" class="auth-form__line-btn" id="lineLoginBtn"><%= it.t('auth.login.line') %></button>
    <p class="auth-form__switch"><span><%= it.t('auth.login.switch') %></span><a href="/register"><%= it.t('auth.login.switchLink') %></a></p>
  </div>
</main>
