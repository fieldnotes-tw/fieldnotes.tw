<% if ((it.contributors || []).length) { %>
<section class="contributors" id="contributors">
  <div class="contributors__head"><%= it.t('home.contributors.title') %></div>
  <ul class="observer-list">
    <% it.contributors.forEach((person) => { %>
    <li class="observer-item<%= (!person.bio && !person.id) ? ' observer-item--static' : '' %>">
      <% if (person.bio || person.id) { %>
      <button type="button" class="observer-item__toggle" aria-expanded="false">
        <% if (person.avatarUrl) { %>
        <span class="avatar avatar--sm"><img src="<%= person.avatarUrl %>" alt="" class="detail__member-avatar-img"></span>
        <% } else { %>
        <span class="avatar avatar--sm" data-cat="<%= person.avatarCategory %>"><%= Array.from(person.name).filter((ch) => !/\s/u.test(ch))[0] || person.name.charAt(0) %></span>
        <% } %>
        <span class="observer-item__name"><%= person.name %></span>
        <svg class="observer-item__chevron" viewBox="0 0 24 24" width="14" height="14"><path d="M6 9 L12 15 L18 9" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" fill="none"/></svg>
      </button>
      <div class="observer-item__body">
        <div class="observer-item__body-inner">
          <% if (person.bio) { %><p><%= person.bio %></p><% } %>
          <% if (person.id) { %>
          <a class="observer-item__link" href="/members/<%= person.id %>"><%= it.t('home.observers.viewProfile') %></a>
          <% } %>
        </div>
      </div>
      <% } else { %>
      <div class="observer-item__row">
        <% if (person.avatarUrl) { %>
        <span class="avatar avatar--sm"><img src="<%= person.avatarUrl %>" alt="" class="detail__member-avatar-img"></span>
        <% } else { %>
        <span class="avatar avatar--sm" data-cat="<%= person.avatarCategory %>"><%= Array.from(person.name).filter((ch) => !/\s/u.test(ch))[0] || person.name.charAt(0) %></span>
        <% } %>
        <span class="observer-item__name"><%= person.name %></span>
      </div>
      <% } %>
    </li>
    <% }) %>
  </ul>
</section>
<% } %>
