<div class="submit-form__datetime submit-form__datetime--combo">
  <label class="submit-form__datetime-date">
    <span class="visually-hidden"><%= it.t('form.datetime.date') %></span>
    <input type="date" id="f_seenDate" required>
  </label>
  <label class="submit-form__datetime-time">
    <span class="visually-hidden"><%= it.t('form.datetime.time') %></span>
    <input type="time" id="f_seenTime" required>
  </label>
</div>
