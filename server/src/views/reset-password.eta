<header class="auth-page-head">
  <a href="/" class="brand-mark" aria-label="<%= it.t('brand.name') %>"><span>最</span><span>近</span><span>高</span><span>雄</span></a>
  <div class="auth-nav" data-auth-nav></div>
</header>

<main class="auth-main">
  <form class="auth-form" id="resetForm" novalidate>
    <h1 class="auth-form__title"><%= it.t('auth.reset.title') %></h1>
    <p class="auth-form__hint"><%= it.t('auth.reset.hint') %></p>
    <label class="auth-form__field">
      <span><%= it.t('auth.field.password') %></span>
      <input type="password" name="password" autocomplete="new-password" required minlength="8">
    </label>
    <label class="auth-form__field">
      <span><%= it.t('auth.register.confirmPassword') %></span>
      <input type="password" name="confirmPassword" autocomplete="new-password" required minlength="8">
    </label>
    <p class="auth-form__error" id="resetError" hidden></p>
    <button type="submit" class="auth-form__submit"><%= it.t('auth.reset.submit') %></button>
    <p class="auth-form__switch"><a href="/login"><%= it.t('auth.forgot.backToLogin') %></a></p>
  </form>
</main>
