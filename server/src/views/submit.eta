<header class="auth-page-head">
  <a href="/" class="brand-mark" aria-label="<%= it.t('brand.name') %>"><span>最</span><span>近</span><span>高</span><span>雄</span></a>
  <div class="auth-nav" data-auth-nav></div>
</header>

<main class="auth-main auth-main--submit">
  <form class="submit-form" id="submitForm" novalidate>
    <header class="submit-form__intro">
      <div class="submit-form__intro-head">
        <h1 class="submit-form__title" id="submitPageTitle"><%= it.t('submit.title') %></h1>
        <button type="button" class="submit-form__delete submit-form__delete--intro" id="submitDeleteBtn" hidden><%= it.t('submit.delete') %></button>
      </div>
    </header>

    <div class="submit-form__draft-banner" id="submitDraftBanner" hidden>
      <p class="submit-form__draft-banner-text" id="submitDraftBannerText"></p>
      <div class="submit-form__draft-banner-actions">
        <button type="button" class="submit-form__draft-restore" id="submitDraftRestoreBtn"><%= it.t('submit.draft.restore') %></button>
        <button type="button" class="submit-form__draft-discard" id="submitDraftDiscardBtn"><%= it.t('submit.draft.discard') %></button>
      </div>
    </div>

    <section class="submit-form__section" aria-labelledby="submitWhat">
      <h2 class="submit-form__section-title" id="submitWhat"><%= it.t('submit.what.label') %></h2>
      <label class="submit-form__field">
        <span class="visually-hidden"><%= it.t('submit.what.label') %></span>
        <input type="text" id="f_title" maxlength="200" required>
      </label>
      <p class="submit-form__hint submit-form__photo-hint" id="photoDragHint" hidden><%= it.t('submit.photo.dragHint') %></p>
      <div class="submit-form__photo">
        <ul class="submit-form__photo-list" id="photoList" aria-live="polite"></ul>
        <label class="submit-form__photo-upload">
          <input type="file" id="f_image" accept="image/jpeg,image/png,image/webp,video/mp4,video/webm,video/quicktime" multiple hidden>
          <span class="submit-form__photo-btn"><%= it.t('submit.photo.upload') %></span>
        </label>
        <p class="submit-form__photo-status" id="imageStatus" hidden></p>
      </div>
    </section>

    <section class="submit-form__section" aria-labelledby="submitCategory">
      <h2 class="submit-form__section-title" id="submitCategory"><%= it.t('submit.category.label') %></h2>
      <p class="submit-form__hint"><%= it.t('submit.category.hint') %></p>
      <fieldset class="submit-form__category">
        <legend class="visually-hidden"><%= it.t('submit.category.label') %></legend>
        <label class="submit-form__category-btn" data-category="plant">
          <input type="checkbox" name="category" value="plant" checked>
          <span><%= it.t('category.plant') %></span>
        </label>
        <label class="submit-form__category-btn" data-category="animal">
          <input type="checkbox" name="category" value="animal">
          <span><%= it.t('category.animal') %></span>
        </label>
        <label class="submit-form__category-btn" data-category="sky">
          <input type="checkbox" name="category" value="sky">
          <span><%= it.t('category.sky') %></span>
        </label>
        <label class="submit-form__category-btn" data-category="taste">
          <input type="checkbox" name="category" value="taste">
          <span><%= it.t('category.taste') %></span>
        </label>
        <label class="submit-form__category-btn" data-category="workshop">
          <input type="checkbox" name="category" value="workshop">
          <span><%= it.t('category.workshop') %></span>
        </label>
      </fieldset>
    </section>

    <section class="submit-form__section submit-form__section--desc" aria-labelledby="submitDesc">
      <h2 class="submit-form__section-title" id="submitDesc"><%= it.t('submit.description.label') %></h2>
      <p class="submit-form__hint" id="submitDescHint"><%= it.t('submit.description.hint') %></p>
      <label class="submit-form__field submit-form__field--desc">
        <span class="visually-hidden"><%= it.t('submit.description.label') %></span>
        <textarea id="f_description" rows="3" maxlength="120" required aria-describedby="submitDescHint descriptionCounter"></textarea>
        <p class="submit-form__counter" id="descriptionCounter" aria-live="polite">0 / 120</p>
      </label>
      <button type="button" class="submit-form__extra-toggle" id="extraToggle" aria-expanded="false" aria-controls="extraPanel">
        <%= it.t('submit.extra.toggle') %>
      </button>
      <div class="submit-form__extra-panel" id="extraPanel" hidden>
        <label class="submit-form__field">
          <span class="visually-hidden"><%= it.t('submit.extra.label') %></span>
          <textarea id="f_extra" rows="6"></textarea>
        </label>
      </div>
    </section>

    <section class="submit-form__section" aria-labelledby="submitWhenWhere">
      <h2 class="submit-form__section-title" id="submitWhenWhere"><%= it.t('submit.whenWhere.label') %></h2>
      <div class="submit-form__whenwhere">
        <div class="submit-form__whenwhere-block">
          <%~ include('partials/datetime-fields', it) %>
        </div>
        <div class="submit-form__whenwhere-block">
          <div class="submit-form__search">
            <input
              type="search"
              id="f_location"
              class="submit-form__search-input"
              maxlength="300"
              autocomplete="off"
              placeholder="<%= it.t('submit.where.placeholder') %>"
              aria-controls="searchResults"
              aria-expanded="false"
            >
            <ul class="submit-form__search-results" id="searchResults" hidden role="listbox"></ul>
          </div>
          <p class="submit-form__hint submit-form__map-hint" id="submitMapHint" aria-live="polite"><%= it.t('submit.where.mapHintEmpty') %></p>
          <div class="submit-form__map-wrap submit-form__map-wrap--unpinned">
            <div class="submit-form__map" id="submitMap" role="application" aria-label="<%= it.t('submit.where.mapLabel') %>"></div>
          </div>
          <input type="hidden" id="f_lat">
          <input type="hidden" id="f_lng">
          <label class="submit-form__field submit-form__whenwhere-note">
            <span class="visually-hidden"><%= it.t('submit.whenWhere.note') %></span>
            <textarea id="f_finding" rows="2" maxlength="500" placeholder="<%= it.t('submit.whenWhere.notePlaceholder') %>"></textarea>
          </label>
        </div>
      </div>
    </section>

    <p class="submit-form__error" id="submitError" hidden></p>
    <div class="submit-form__primary-actions">
      <button type="submit" class="submit-form__submit" id="submitBtn"><%= it.t('submit.send') %></button>
    </div>
  </form>

  <div class="submit-form__success" id="submitSuccess" hidden>
    <div class="submit-form__success-inner">
      <h1 class="submit-form__title"><%= it.t('submit.success.title') %></h1>
      <p class="submit-form__lede"><%= it.t('submit.success.body') %></p>
      <div class="submit-form__success-actions">
        <a href="/" class="submit-form__success-view" id="submitSuccessView" hidden><%= it.t('submit.success.view') %></a>
        <button type="button" class="submit-form__success-again" id="submitAgain"><%= it.t('submit.success.again') %></button>
      </div>
    </div>
  </div>
</main>
